# =============================================================================
# Personal Finance App - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local or any file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Production: Use SSL (add ?ssl=require) and rotate password every 90 days
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_app

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION
# -----------------------------------------------------------------------------
# Session signing secret - MUST be 32+ bytes of cryptographic randomness
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Never use default value in production! Rotate every 30 days.
SESSION_SECRET=change-me-generate-32-byte-random-secret

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# Client URL (required in production for CORS)
CLIENT_URL=http://localhost:5000

# Application URL (used for email links)
APP_URL=http://localhost:5000

# Trust proxy headers (set to true when behind a reverse proxy/load balancer)
# SECURITY: Only enable in production when properly configured
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# SMTP / EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# SMTP server settings (all required for email functionality)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
# Optional From display name; unset keeps "Personal Finance App".
# SMTP_FROM_NAME=Personal Finance App

# -----------------------------------------------------------------------------
# RATE LIMITING (Production)
# -----------------------------------------------------------------------------
# Redis URL for distributed rate limiting (recommended for multi-server deployments)
# Without Redis, rate limits are per-server only
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# CRON / SCHEDULED JOBS
# -----------------------------------------------------------------------------
# In-process scheduler + outbox processor. Default: on in production, off
# otherwise; always off under NODE_ENV=test.
# SCHEDULER_ENABLED=false
# HTTP cron door (/api/cron/*). Default: mounted. CRON_SECRET is REQUIRED in
# production (boot fails without it). In dev/test it is optional: without it the
# routes refuse every request (403) and startup logs a warning.
# CRON_HTTP_ENABLED=true
# Secret header for authenticating cron job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=your-cron-secret

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS
# -----------------------------------------------------------------------------
# Logo.dev API token (for merchant logos in scripts)
# LOGO_DEV_TOKEN=your-logo-dev-token

# Weekly recap provider FX validity, in calendar days after the quoted date (0 to 3).
FX_FLOW_MAX_CARRY_DAYS=3

# Exchange rate API key (for FX rates)
# EXCHANGE_RATE_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# CSP violation reporting URI (optional)
# CSP_REPORT_URI=https://your-csp-reporting-service.com/report

# Graceful shutdown timeout in milliseconds (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Enable AI assistant features
# AI_ENABLED=true

# Thandi AI assistant providers (R17). Claude primary, Gemini fallback.
# Server-side only: never use VITE_* names for keys. Each key needs its model
# id; there is no default model. With no provider configured Thandi answers in
# the labelled limited local mode. Real keys come from the secret store, never
# from this file.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Paid providers stay OFF until an operator call cap is set: a positive
# integer ceiling on dispatched calls per provider + model per rolling 24 h.
# Without it the provider reports "no_cap" and Thandi answers locally.
# AI_ANTHROPIC_DAILY_CALL_CAP=
# AI_GEMINI_DAILY_CALL_CAP=
# AI_PRIMARY_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=gemini
# AI_REQUEST_DEADLINE_MS=30000
# AI_STAGE_TIMEOUT_MS=12000
# AI_FALLBACK_RESERVE_MS=8000

# Enable investment module
# INVESTMENTS_ENABLED=true

# =============================================================================
# UPLOADED FILE STORAGE (OPS-001)
# =============================================================================
# Receipts, attachments and images are stored through one ObjectStore with a
# storage_objects manifest (sha256 checked on every read).
# local (default): files under STORAGE_LOCAL_DIR (default ./private-objects).
#   Must be a persistent directory, never inside uploads/. A container's own
#   disk is wiped on redeploy.
# s3: an S3-compatible bucket; set every S3_* variable (core/storage/config.ts).
# The production choice (D18: persistent disk vs object storage) is the owner's.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/var/data/objects
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://objects.example.com/
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# [ ] DATABASE_URL uses SSL (?ssl=require)
# [ ] SESSION_SECRET is 32+ bytes of cryptographic randomness
# [ ] SMTP credentials are real app passwords (not main account passwords)
# [ ] CLIENT_URL is set to your actual domain
# [ ] TRUST_PROXY=true if behind a reverse proxy
# [ ] REDIS_URL is configured for distributed rate limiting
# [ ] CRON_SECRET is set for scheduled job authentication
# [ ] STORAGE_LOCAL_DIR is on a persistent disk (or STORAGE_DRIVER=s3 is configured)
# [ ] All secrets are stored in a secure secrets manager (not .env files)
# =============================================================================
