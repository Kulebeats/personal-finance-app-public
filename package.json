{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "tsx server/index-dev.ts",
    "start:fresh": "npx kill-port 5000 && npm run dev",
    "kill:port": "npx kill-port 5000",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "deploy:verify": "node scripts/verify-deploy-readiness.mjs",
    "check": "tsc && node scripts/check-no-storage-imports.mjs && node scripts/check-loc-limits.mjs && node scripts/check-node-tool-syntax.mjs && node scripts/tools/check-module-assessment-metadata.mjs && node scripts/tools/generate-module-assessment-status-report.mjs --check && node scripts/tools/check-w9-template-coverage.mjs && node scripts/tools/check-w10-worksheet-coverage.mjs",
    "check:storage-imports": "node scripts/check-no-storage-imports.mjs",
    "check:node-tools": "node scripts/check-node-tool-syntax.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest --config client/vitest.config.ts",
    "test:run": "vitest run --config client/vitest.config.ts",
    "test:run:settings": "vitest run --config client/vitest.config.ts client/src/pages/settings client/src/features/settings",
    "test:run:rest": "vitest run --config client/vitest.config.ts --exclude \"client/src/pages/settings/**\" --exclude \"client/src/features/settings/**\"",
    "test:run:split": "npm run test:run:settings && npm run test:run:rest",
    "test:client:integration": "vitest run client/src/pages/settings/__tests__/integration.test.tsx --config client/vitest.config.ts",
    "test:server": "cd server && vitest",
    "test:server:run": "cd server && vitest run",
    "test:ai:eval": "tsx scripts/ai-eval-gate.ts",
    "test:jarvis": "vitest run --config scripts/jarvis/vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config client/vitest.config.ts",
    "test:coverage:server": "cd server && vitest run --coverage",
    "test:coverage:all": "npm run test:coverage && npm run test:coverage:server",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/auth.spec.ts e2e/transactions.spec.ts e2e/accounts.spec.ts e2e/budget.spec.ts e2e/dashboard.spec.ts e2e/organization.spec.ts e2e/goals.spec.ts e2e/investments.spec.ts e2e/recurring.spec.ts --project=chromium --reporter=line",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "migrate:merchants": "tsx server/migrate-merchant-columns.ts",
    "report:modules": "node scripts/tools/generate-module-assessment-status-report.mjs",
    "check:modules-final": "node scripts/tools/generate-module-assessment-status-report.mjs --require-final-ready",
    "check:modules-report": "node scripts/tools/generate-module-assessment-status-report.mjs --check",
    "check:module-metadata": "node scripts/tools/check-module-assessment-metadata.mjs",
    "smoke:staging:health": "node scripts/tools/check-staging-health.mjs",
    "check:w9-evidence": "node scripts/tools/check-w9-evidence.mjs",
    "check:w9-template": "node scripts/tools/check-w9-template-coverage.mjs",
    "check:w10-worksheet": "node scripts/tools/check-w10-worksheet-coverage.mjs",
    "check:bundle": "node scripts/check-client-bundle-budget.mjs",
    "db:test:setup": "node scripts/setup-test-db.mjs"
  },
  "notes": "removed framer motion dependency",
